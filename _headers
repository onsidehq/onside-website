# Einstellungen für Cloudflare Pages (wird beim Hochladen automatisch gelesen).
# Oben: Sicherheitsregeln für alle Seiten. Darunter: wie lange Browser Dateien
# zwischenspeichern dürfen. Fotos 30 Tage. Ein neues Foto bekommt deshalb immer
# einen neuen Dateinamen (siehe BILDER.md), dann ist es sofort überall zu sehen.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  Strict-Transport-Security: max-age=31536000

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/assets/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400

/css/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/js/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
