{
  // Cloudflare Worker für onsidehq.de (statische Seiten + KI-Chat unter /api/assistent).
  // Der Schlüssel ANTHROPIC_API_KEY wird als Secret im Cloudflare-Dashboard hinterlegt, nie hier.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "onside-website",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-06",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "404-page"
  },
  "previews": {}
}
